# PostgreSQL
DATABASE_URL=postgresql://pool_manager:change_this_password@localhost:5432/pool_manager
# Make user pool_manager and database also pool_manager

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# JWT Configuration
# Generate with: openssl rand -base64 48
JWT_SECRET=

# First administrator only; use a unique email and a password of at least 16 characters
ADMIN_EMAIL=
ADMIN_PASSWORD=
#Password should be atleast 16 characters.

# Server Configuration
PORT=3000
UPLOAD_DIR=./uploads
# Set to the number of trusted reverse-proxy hops when deployed behind a proxy
TRUST_PROXY_HOPS=0
